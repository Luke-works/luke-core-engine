<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================= -->
    <!-- Parent: Spring Boot 3.4.4                                     -->
    <!-- ============================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.13</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- ============================================================= -->
    <!-- Project coordinates                                           -->
    <!-- ============================================================= -->
    <groupId>com.luke</groupId>
    <artifactId>luke-core-engine</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Luke Core Engine</name>
    <description>FluxNova (FINOS) Camunda 7 Engine with Spring Boot and PostgreSQL</description>

    <!-- ============================================================= -->
    <!-- Properties                                                    -->
    <!-- ============================================================= -->
    <properties>
        <java.version>21</java.version>
        <!-- Override the BOM-managed netty (pulled transitively by lettuce-core, added for the
             #55 shared rate limiter) to the patched version: 4.1.135 has CVE-2026-59901
             (Bzip2Decoder infinite loop), fixed in 4.1.136. Mirrors auth-engine #41. -->
        <netty.version>4.1.136.Final</netty.version>
        <fluxnova.version>2.0.3</fluxnova.version>
        <!-- Signatures capability (merged from luke-signature-engine, SIG-M) -->
        <pdfbox.version>3.0.3</pdfbox.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <awssdk.version>2.25.60</awssdk.version>
    </properties>

    <!-- ============================================================= -->
    <!-- Dependency Management: FluxNova BOM                           -->
    <!-- ============================================================= -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.finos.fluxnova.bpm</groupId>
                <artifactId>fluxnova-bom</artifactId>
                <version>${fluxnova.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AWS SDK BOM — manages the s3 client version (signatures DocumentStore) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================================================= -->
    <!-- Dependencies                                                  -->
    <!-- ============================================================= -->
    <dependencies>

        <!-- FluxNova Spring Boot Starters -->
        <dependency>
            <groupId>org.finos.fluxnova.bpm.springboot</groupId>
            <artifactId>fluxnova-bpm-spring-boot-starter-rest</artifactId>
        </dependency>
        <!-- FluxNova webapp removed — Luke Core UI replaces it -->

        <!-- FluxNova Spin JSON Plugin (for Object/JSON variable serialization) -->
        <dependency>
            <groupId>org.finos.fluxnova.bpm</groupId>
            <artifactId>fluxnova-engine-plugin-spin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.finos.fluxnova.spin</groupId>
            <artifactId>fluxnova-spin-dataformat-json-jackson</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- FluxNova Connect (HTTP/SOAP connectors for Service Tasks) -->
        <!--                                                           -->
        <!-- Without these, the Spring Boot starter's @ConditionalOn-  -->
        <!-- Class auto-config for ConnectProcessEnginePlugin never    -->
        <!-- fires, so the BPMN parser installs no connector parse     -->
        <!-- listener and <camunda:connector> elements on Service      -->
        <!-- Tasks are silently ignored (connector never linked).      -->
        <!--                                                           -->
        <!-- engine-plugin-connect → registers the parse listener that -->
        <!--   binds connectors to Service Tasks at deployment time.   -->
        <!-- connect-connectors-all → the HTTP + SOAP connector        -->
        <!--   implementations invoked at runtime.                     -->
        <!-- Versions are managed by the fluxnova-bom.                 -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.finos.fluxnova.bpm</groupId>
            <artifactId>fluxnova-engine-plugin-connect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.finos.fluxnova.connect</groupId>
            <artifactId>fluxnova-connect-connectors-all</artifactId>
        </dependency>

        <!-- NOTE (#22): the JSR-223 scripting engines (Groovy, GraalVM JS, Jython) were removed to
             cut the container's off-heap/native footprint on the 512 MB Render starter plan. No
             deployed or generated BPMN uses a <scriptTask> (the WORKFLOW compiler emits job-worker /
             outbox steps, not scripts) and Camunda ${...} expressions use the built-in JUEL engine,
             not these. GraalVM polyglot (large native/Metaspace footprint) + Jython (huge jar) were
             the worst offenders. If script tasks are ever needed, re-add exactly ONE engine here and
             restore ScriptingEnginePlugin (git history). -->

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Lettuce (Redis client) for the shared, cross-replica embed rate limiter (#55). Used
             ONLY when REDIS_URL is set; the limiter falls back to the in-memory per-instance store
             otherwise (default-lenient). Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <!-- OpenAPI: machine-readable spec of the custom /api/** surface at /v3/api-docs (#35).
             springdoc auto-derives operations from the Spring @RestController mappings (the
             JAX-RS /engine-rest surface is Camunda's own and not scanned). The -api variant is
             JSON-only (no Swagger UI webjars) to keep the dependency + CVE surface small, mirroring
             auth-engine #59. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>2.8.9</version>
        </dependency>
        <!-- JWT verification (NimbusJwtDecoder) for consumer-gateway Bearer tokens
             minted by luke-auth-engine; verified against its published JWKS. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- OBS-2: Prometheus metrics registry. Exposes /actuator/prometheus (latency, throughput,
             JVM, HikariCP pool) for the Grafana Alloy collector. Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- OBS-4: backend error tracking. DSN-gated — inert until SENTRY_DSN is set (Spring relaxed
             binding maps the env var to sentry.dsn), so dev/qa run with no config and no calls out. -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry-spring-boot-starter-jakarta</artifactId>
            <version>8.50.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Merged from capability-engine: bean validation (@Valid on capability controllers) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Merged from capability-engine: JOSE/JWT (GatewayTokenVerifier). Also pulled
             transitively by oauth2-resource-server above; declared explicitly to match. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- ========================================================= -->
        <!-- Signatures capability (merged from luke-signature-engine) -->
        <!-- Permissive licenses only: PDFBox (Apache-2.0), Bouncy-    -->
        <!-- Castle bcpkix (MIT), AWS SDK s3 (Apache-2.0). NEVER iText -->
        <!-- (AGPL). Visual stamp + PAdES seal + S3-compatible store.  -->
        <!-- ========================================================= -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- Database: H2 (default) + PostgreSQL (optional via postgres profile) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: versioned migrations for the custom luke_* tables (#24).
             Active only under the postgres profile (spring.flyway.enabled). The
             postgresql module is required for Flyway 10+ Postgres support. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers (versions managed by the Spring Boot BOM): a real PostgreSQL for the
             entity↔migration schema-validation test that H2 cannot provide. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Embedded Redis for the shared-limiter integration test (#55; no Docker needed). -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>1.4.3</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ============================================================= -->
    <!-- Build                                                         -->
    <!-- ============================================================= -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Generate META-INF/build-info.properties so /actuator/info reports the
                         build time + version — lets us confirm which commit a deployed instance
                         is actually running (previously /actuator/info returned empty {}). -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
